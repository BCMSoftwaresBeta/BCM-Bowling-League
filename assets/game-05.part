nerHTML = `

   <div class="game-progress">Game ${idx+1} of 3</div>

   <div class="lanes-wrap">

     ${laneHtml('A', matchModal.res.pA, 0)}

     ${laneHtml('B', matchModal.res.pB, 0)}

   </div>

   <div class="game-log" id="gameLog">Rolling…</div>

   <div class="match-modal-actions">

     <button class="ghost" id="btnSkipAnim">Skip Animation</button>

   </div>

 `;

 document.getElementById('btnSkipAnim').addEventListener('click', ()=>{

   matchModal.skipRequested = true;

   clearModalTimers();

   finishGameReveal(finalA, finalB);

 });

 

 let running = { A:0, B:0 };

 const runStep = (step) => {

   if(matchModal.skipRequested || step>=ANIM_STEPS){

     finishGameReveal(finalA, finalB);

     return;

   }

   const ballA = document.getElementById('ballA'), ballB = document.getElementById('ballB');

   const pinsA = document.querySelectorAll('#pinRackA .pin'), pinsB = document.querySelectorAll('#pinRackB .pin');

   if(ballA) ballA.classList.add('rolling');

   if(ballB) ballB.classList.add('rolling');

 

   matchModal.timers.push(setTimeout(()=>{

     if(matchModal.skipRequested){ finishGameReveal(finalA, finalB); return; }

     // knock down a random flavor subset of pins (cosmetic only)

     pinsA.forEach(p=>{ if(Math.random()<0.55) p.classList.add('down'); });

     pinsB.forEach(p=>{ if(Math.random()<0.55) p.classList.add('down'); });

     running.A += incsA[step]; running.B += incsB[step];

     const scoreA = document.getElementById('scoreA'), scoreB = document.getElementById('scoreB');

     if(scoreA) scoreA.textContent = running.A;

     if(scoreB) scoreB.textContent = running.B;

   }, ANIM_ROLL_MS));

 

   matchModal.timers.push(setTimeout(()=>{

     if(matchModal.skipRequested){ finishGameReveal(finalA, finalB); return; }

     if(ballA) ballA.classList.remove('rolling');

     if(ballB) ballB.classList.remove('rolling');

     pinsA.forEach(p=>p.classList.remove('down'));

     pinsB.forEach(p=>p.classList.remove('down'));

     runStep(step+1);

   }, ANIM_STEP_MS));

 };

 runStep(0);

}

 

function finishGameReveal(finalA, finalB){

 clearModalTimers();

 const scoreA = document.getElementById('scoreA'), scoreB = document.getElementById('scoreB');

 if(scoreA) scoreA.textContent = finalA;

 if(scoreB) scoreB.textContent = finalB;

 const log = document.getElementById('gameLog');

 const idx = matchModal.gameIndex;

 const A = matchModal.res.pA, B = matchModal.res.pB;

 if(log) log.textContent = `Game ${idx+1}: ${A.name} ${finalA} — ${B.name} ${finalB}`;

 

 matchModal.gameIndex++;

 const actions = document.querySelector('.match-modal-actions');

 if(matchModal.gameIndex < 3){

   if(actions) actions.innerHTML = `<button class="primary" id="btnNextGame">Start Game ${matchModal.gameIndex+1}</button><button class="ghost" id="btnSkipRest">Skip Animation</button>`;

   const nextBtn = document.getElementById('btnNextGame');

   const skipBtn = document.getElementById('btnSkipRest');

   if(nextBtn) nextBtn.addEventListener('click', ()=>{ matchModal.skipRequested=false; beginCurrentGameAnimation(); });

   if(skipBtn) skipBtn.addEventListener('click', ()=>{ revealRemainingGamesInstantly(); });

 } else {

   showMatchSummary();

 }

}

 

function revealRemainingGamesInstantly(){

 clearModalTimers();

 showMatchSummary();

}

 

function showMatchSummary(){

 clearModalTimers();

 const key = matchModal.key;

 const res = matchModal.res;

 commitMatch(key, res);

 renderBracket();

 

 const winnerWL = res.winner.name;

 document.getElementById('matchModalBody').innerHTML = `

   <div class="match-summary">

     <div class="winner-line">${res.winner.emoji} ${res.winner.name} wins the match</div>

     <div class="score-line">${res.gamesA.join('-')} (${res.totalA}) &nbsp;vs&nbsp; ${res.gamesB.join('-')} (${res.totalB})</div>

   </div>

   <div class="match-modal-actions" id="postMatchActions"></div>

 `;

 

 const nextKey = getNextPlayableMatchKey();

 const gfKeys = ['GF1','GF2','GF3'];

 const actions = document.getElementById('postMatchActions');

 if(matchModal.chainMode && nextKey && gfKeys.includes(nextKey) && !playoffs.champion){

   const label = playoffs.M[nextKey].roundLabel;

   actions.innerHTML = `<button class="primary" id="btnContinueChain">Play ${label}</button>`;

   document.getElementById('btnContinueChain').addEventListener('click', ()=>{

     openMatchForKey(nextKey, true);

   });

 } else {

   const label = playoffs.champion ? 'Close' : 'Continue';

   actions.innerHTML = `<button class="primary" id="btnCloseMatchModal">${label}</button>`;

   document.getElementById('btnCloseMatchModal').addEventListener('click', closeMatchModal);

 }

}

 

function closeMatchModal(){

 clearModalTimers();

 matchModal.active = false;

 document.getElementById('matchAnimModal').classList.add('hidden');

 renderBracket();

 if(autoSimAfterModal){

   const opts = autoSimAfterModal;

   autoSimAfterModal = null;

   simulateRestRespectingFollow(opts.stopBeforeFinals);

 }

}

 

/* =========================================================================

  BRACKET RENDER

  ========================================================================= */

function sideHtml(player, score, isWinner, isTbd){

 if(isTbd){

   return `<div class="m-side tbd"><span class="who">TBD</span></div>`;

 }

 return `<div class="m-side ${isWinner?'winner':''}">

     <span class="who">${player.emoji} ${player.name}<span class="seed">#${player.seed}</span></span>

     <span class="score">${score!==undefined?score:''}</span>

   </div>`;

}

 

function matchCardHtml(m){

 const A = m.getA(), B = m.getB();

 const cls = m.played ? 'done' : (A && B ? 'live' : '');

 if(m.skipped){

   return `<div class="match"><div class="round-label" style="margin:0 0 4px;">${m.roundLabel}</div>

     <div class="m-side tbd"><span class="who">Not needed</span></div></div>`;

 }

 let aHtml, bHtml, gamesLine='';

 if(!m.played){

   aHtml = A ? sideHtml(A) : sideHtml(null,undefined,false,true);

   bHtml = B ? sideHtml(B) : sideHtml(null,undefined,false,true);

 } else {

   const r = m.result;

   aHtml = sideHtml(r.pA, r.totalA, r.winner.id===r.pA.id);

   bHtml = sideHtml(r.pB, r.totalB, r.winner.id===r.pB.id);

   gamesLine = `<div class="m-games">${r.pA.name}: ${r.gamesA.join('-')} &nbsp;|&nbsp; ${r.pB.name}: ${r.gamesB.join('-')}</div>`;

 }

 return `<div class="match ${cls}">

   <div class="round-label" style="margin:0 0 4px;">${m.roundLabel}</div>

   ${aHtml}<div class="m-mid-rule"></div>${bHtml}

   ${gamesLine}

 </div>`;

}

 

function renderBracket(){

 document.getElementById('playoffPanel').style.display='block';

 document.getElementById('playoffIntroPanel').style.display='none';

 

 const winnersOrder = [

   {label:'Play-In', keys:['PI']},

   {label:'Quarterfinals', keys:['QF1','QF2','QF3','QF4']},

   {label:'Semifinals', keys:['SF1','SF2']},

   {label:'Winners Final', keys:['WF']},

 ];

 document.getElementById('winnersRounds').innerHTML = winnersOrder.map(col=>`

   <div class="round-col">

     <div class="round-label">${col.label}</div>

     ${col.keys.map(k=>matchCardHtmlWithRecords(playoffs.M[k])).join('')}

   </div>`).join('');

 

 const losersOrder = [

   {label:'Round 1', keys:['LR1a','LR1b']},

   {label:'Round 2', keys:['LR2a','LR2b']},

   {label:'Round 3', keys:['LR3a','LR3b']},

   {label:'Losers Final', keys:['LR4']},

 ];

 document.getElementById('losersRounds').innerHTML = losersOrder.map(col=>`

   <div class="round-col">

     <div class="round-label">${col.label}</div>

     ${col.keys.map(k=>matchCardHtmlWithRecords(playoffs.M[k])).join('')}

   </div>`).join('');

 

 document.getElementById('grandFinalRound').innerHTML = `

   <div class="round-col" style="min-width:220px;">

     ${['GF1','GF2','GF3'].map(k=>matchCardHtmlWithRecords(playoffs.M[k])).join('')}

   </div>`;

 

 const played = playoffs.order.filter(k=>playoffs.M[k].played && !playoffs.M[k].skipped).length;

 document.getElementById('playoffSub').textContent = playoffs.champion

   ? 'Champion crowned'

   : `${played} matches complete`;

 

 const finalsReady = !!(winnerOf('WF') && winnerOf('LR4')) && !playoffs.champion;

 const watchFinalsBtn = document.getElementById('btnWatchFinals');

 if(watchFinalsBtn) watchFinalsBtn.disabled = !finalsReady;

 const simToChampBtn = document.getElementById('btnSimToChamp');

 if(simToChampBtn) simToChampBtn.disabled = finalsReady || !!playoffs.champion;

 

 if(playoffs.champion){

   setPlayoffButtonsDisabled(true);

   showChampion();

 }

}

 

function showChampion(){

 const c = playoffs.champion;

 document.getElementById('championPanel').style.display='block';

 document.getElementById('championName').textContent = `${c.emoji} ${c.name}`;

 document.getElementById('championSub').textContent = `Season Champion — Seed #${c.seed}`;

 updateStatus();

 updateResetButtonLabel();

 renderCareerHub();

 autosaveGame();

}

 

/* =========================================================================

  HALL OF FAME

  ========================================================================= */

function recordHallOfFame(){

 if(!playoffs || !playoffs.champion || playoffs.recorded) return;

 playoffs.recorded = true;

 const c = playoffs.champion;

 c.championships = (c.championships||0) + 1;

 const label = careerModeOn ? careerYear : seasonNumber;

 hallOfFame.push({ season: label, playerId:c.id, name: c.name, emoji: c.emoji, seed: c.seed, seasonTotal: c.seasonTotal, careerMode: careerModeOn });

 renderHallOfFame();

}

 

function renderHallOfFame(){
 const wrap = document.getElementById('hallOfFamePanel');
 if(!wrap) return;
 if(hallOfFame.length===0){ wrap.style.display='none'; return; }
 wrap.style.display='block';
 const counts = {};
 hallOfFame.forEach(h=>{ counts[h.name] = (counts[h.name]||0)+1; });
 const topName = Object.entries(counts).sort((a,b)=>b[1]-a[1])[0];
 const rows = hallOfFame.slice().reverse().map(h=>{
   const pl = h.playerId ? PLAYERS[h.playerId] : Object.values(PLAYERS).find(p=>p.name===h.name);
   const extras = pl ? `${pl.championships?`<span class="badge-mini ring">💍 ${pl.championships}</span>`:''}${totalMVPs(pl)?`<span class="badge-mini mvp">★ ${totalMVPs(pl)}</span>`:''}` : '';
   const click = h.careerMode ? ` class="click-row" onclick="window.__openSeasonArchive(${h.season})" title="Open Year ${h.season} archive"` : '';
   return `<tr${click}>
     <td class="odds-seed">${h.careerMode?'Year':'Season'} ${h.season}</td>
     <td class="odds-name">${h.emoji} ${h.name}${extras}</td>
     <td class="odds-seed">Seed #${h.seed}</td>
     <td class="odds-prob" style="text-align:right;">${h.seasonTotal} pins</td>
   </tr>`;
 }).join('');
 document.getElementById('hallOfFameContent').innerHTML = `
   <p class="hint" style="margin:0 0 14px;">${hallOfFame.length} ${careerModeOn?'year':'season'}${hallOfFame.length>1?'s':''} played this session
     ${topName && topName[1]>1 ? ` &nbsp;·&nbsp; <span style="color:var(--gold-bright)">${topName[0]}</span> leads with ${topName[1]} titles` : ''}. ${careerModeOn?'Tap a champion season to open the full archive.':''}</p>
   <table class="odds-table">${rows}</table>`;
}

/* =========================================================================
   ARCADE EDITION HELPERS — career archive, forms, rivalries, save system
   ========================================================================= */
function progressRowHtml(label,value,target){
 const pct = Math.max(0,Math.min(100,(value/target)*100));
 return `<div class="progress-row"><span>${label}</span><div class="progress-bar"><div class="progress-fill" style="width:${pct}%"></div></div><span>${Math.round(value)}/${target}</span></div>`;
}

function accoladeMiniHtml(pl){
 let html='';
 if((pl.championships||0)>0) html += `<span class="badge-mini ring">💍${pl.championships}</span>`;
 if(totalMVPs(pl)>0) html += `<span class="badge-mini mvp">★${totalMVPs(pl)}</span>`;
 if(dynastyStatus(pl)) html += `<span class="badge-mini dynasty">DYNASTY</span>`;
 if(pl.formState==='HOT') html += `<span class="badge-mini hot">HOT</span>`;
 if(pl.formState==='COLD') html += `<span class="badge-mini cold">COLD</span>`;
 return html;
}

function dynastyStatus(pl){
 const years=(pl.championshipYears||[]).slice();
 if(!years.length) return false;
 const lastCompleted = careerModeOn ? (careerYear - ((playoffs&&playoffs.champion)?0:1)) : seasonNumber;
 for(let end=Math.max(5,lastCompleted);end>=5;end--){
   const count=years.filter(y=>y>=end-4 && y<=end).length;
   if(count>=3) return true;
 }
 return false;
}

function prepareWeeklyForms(){
 const events=[];
 Object.values(PLAYERS).forEach(pl=>{
   if((pl.formWeeksLeft||0)<=0){
     pl.formState='NORMAL'; pl.formModifier=0; pl.formWeeksLeft=0;
     const r=Math.random();
     if(r<0.075){
       pl.formState='HOT'; pl.formModifier=Math.round(7+Math.random()*7); pl.formWeeksLeft=2+Math.floor(Math.random()*2);
       events.push(`🔥 ${pl.emoji} ${pl.name} has caught fire and enters a hot streak.`);
     } else if(r<0.14){
       pl.formState='COLD'; pl.formModifier=-Math.round(6+Math.random()*8); pl.formWeeksLeft=2+Math.floor(Math.random()*2);
       events.push(`❄️ ${pl.emoji} ${pl.name} has hit a cold spell.`);
     }
   }
 });
 return events;
}

function decayWeeklyForms(){
 Object.values(PLAYERS).forEach(pl=>{
   if((pl.formWeeksLeft||0)>0){
     pl.formWeeksLeft--;
     if(pl.formWeeksLeft<=0){ pl.formState='NORMAL'; pl.formModifier=0; }
   }
 });
}

function generateWeeklyStorylines(weekData,ordered,formEvents){
 const stories=(formEvents||[]).slice();
 if(ordered.length){
   const leader=ordered[0], second=ordered[1];
   stories.unshift(`🏅 Player of the Week: ${leader===undefined?'—':Object.values(PLAYERS).slice().sort((a,b)=>weekData[b.id].weekTotal-weekData[a.id].weekTotal)[0].emoji+' '+Object.values(PLAYERS).slice().sort((a,b)=>weekData[b.id].weekTotal-weekData[a.id].weekTotal)[0].name}.`);
   if(currentWeek>=7 && ordered[7] && ordered[8]){
     const gap=Math.abs(ordered[7].seasonTotal-ordered[8].seasonTotal);
     stories.push(`📺 Bubble Watch: #8 ${ordered[7].name} and #9 ${ordered[8].name} are separated by ${gap} pins in the race to avoid the play-in.`);
   }
 }
 const prevRanked=Object.values(PLAYERS).filter(p=>p.prevRank).slice().sort((a,b)=>a.prevRank-b.prevRank);
 const priorTop3=prevRanked.filter(p=>p.prevRank<=3);
 priorTop3.forEach(pl=>{
   if(pl.rank>=6) stories.push(`🚨 Meltdown Alert: ${pl.emoji} ${pl.name} fell from #${pl.prevRank} to #${pl.rank}.`);
 });
 Object.values(PLAYERS).forEach(pl=>{
   if(pl.prevRank>=6 && pl.rank<=3) stories.push(`⚡ Upset Alert: ${pl.emoji} ${pl.name} surged from #${pl.prevRank} into the top three.`);
 });
 return stories.slice(0,5);
}

function recordRivalryMatch(res,isChampionship){
 if(!careerModeOn || !res || !res.pA || !res.pB) return;
 const ids=[res.pA.id,res.pB.id].sort(); const key=ids.join('|');
 const book=rivalryBook[key] || {ids,meetings:0,championshipMeetings:0,wins:{},lastYear:null};
 book.meetings++; if(isChampionship) book.championshipMeetings++;
 book.wins[res.winner.id]=(book.wins[res.winner.id]||0)+1; book.lastYear=careerYear;
 rivalryBook[key]=book;
}

function finalizeCareerSeasonMetrics(year){
 const summary=careerHistoryLog.find(x=>x.year===year);
 const champName=summary?.champion?.name;
 Object.values(PLAYERS).forEach(pl=>{
   const regularGames=pl.seasonGames.slice(0,TOTAL_WEEKS*9);
   const seasonAvg=regularGames.length?mean(regularGames):0;
   const playoffWins=playoffs?.recordsWL?.[pl.id]||0;
   const finish=pl.finishHistory[year-1]||pl.lastFinish||null;
   const highGame=pl.seasonGames.length?Math.max(...pl.seasonGames):0;
   pl.bestSeasonAvg=Math.max(pl.bestSeasonAvg||0,seasonAvg);
   pl.bestSeasonTotal=Math.max(pl.bestSeasonTotal||0,pl.seasonTotal);
   pl.bestPlayoffWins=Math.max(pl.bestPlayoffWins||0,playoffWins);
   if(champName===pl.name && !(pl.championshipYears||[]).includes(year)) pl.championshipYears.push(year);
   if(!pl.careerSeasons) pl.careerSeasons=[];
   pl.careerSeasons[year-1]={year,finish,seasonTotal:pl.seasonTotal,seasonAvg,highGame,playoffWins,champion:champName===pl.name,regularMvp:summary?.mvp?.name===pl.name,playoffMvp:summary?.playoffMVP?.name===pl.name};
   pl.tier=computeTier(computePrestigeScore(pl),pl);
 });
 if(!bulkSimMode) renderCareerHub();
}

function renderCareerHub(){
 const panel=document.getElementById('careerHubPanel'); if(!panel) return;
 if(!careerModeOn){panel.style.display='none';return;} panel.style.display='block';
 const arr=Object.values(PLAYERS);
 const ringLeader=arr.slice().sort((a,b)=>(b.championships||0)-(a.championships||0))[0];
 const mvpLeader=arr.slice().sort((a,b)=>totalMVPs(b)-totalMVPs(a))[0];
 const highLeader=arr.slice().sort((a,b)=>b.allTimeHigh-a.allTimeHigh)[0];
 const bestSeason=arr.slice().sort((a,b)=>(b.bestSeasonTotal||0)-(a.bestSeasonTotal||0))[0];
 const rows=arr.slice().sort((a,b)=>computePrestigeScore(b)-computePrestigeScore(a)).map(pl=>{
   const avgFinish=pl.finishHistory.length?mean(pl.finishHistory).toFixed(1):'—';
   return `<tr class="click-row" onclick="window.__showPlayerCard('${pl.id}')"><td class="odds-name">${pl.emoji} ${pl.name}${accoladeMiniHtml(pl)}</td><td>${pl.tier}</td><td class="num">${pl.championships||0}</td><td class="num">${totalMVPs(pl)}</td><td class="num">${pl.finishHistory.filter(x=>x<=3).length}</td><td class="num">${avgFinish}</td><td class="num">${pl.bestSeasonAvg?pl.bestSeasonAvg.toFixed(1):'—'}</td><td class="num">${pl.bestPlayoffWins||0}W</td></tr>`;
 }).join('');
 const rivalries=Object.values(rivalryBook).sort((a,b)=>b.meetings-a.meetings).slice(0,5).map(r=>{
   const A=PLAYERS[r.ids[0]],B=PLAYERS[r.ids[1]]; if(!A||!B)return '';
   return `<div class="metric-card"><div class="metric-kicker">${r.championshipMeetings?'Championship Rivalry':'Playoff Rivalry'} · ${r.meetings} meetings</div><div class="metric-main">${A.emoji} ${A.name} ${r.wins[A.id]||0}-${r.wins[B.id]||0} ${B.name} ${B.emoji}</div><div class="metric-sub">Last meeting: Year ${r.lastYear||'—'}${r.championshipMeetings?` · ${r.championshipMeetings} championship match${r.championshipMeetings>1?'es':''}`:''}</div></div>`;
 }).join('') || `<div class="metric-card"><div class="metric-kicker">Rivalry Board</div><div class="metric-main">Waiting for playoff history</div><div class="metric-sub">Repeated postseason meetings will automatically become tracked rivalries.</div></div>`;
 panel.querySelector('#careerHubContent').innerHTML=`
   <div class="career-grid">
     <div class="metric-card"><div class="metric-kicker">Championship Leader</div><div class="metric-main">${ringLeader.emoji} ${ringLeader.name} · ${ringLeader.championships||0} 💍</div><div class="metric-sub">${dynastyStatus(ringLeader)?'Active dynasty recognized':'3 titles in a 5-year span earns Dynasty status'}</div></div>
     <div class="metric-card"><div class="metric-kicker">MVP Leader</div><div class="metric-main">${mvpLeader.emoji} ${mvpLeader.name} · ${totalMVPs(mvpLeader)} ★</div><div class="metric-sub">Regular season + playoff MVP awards</div></div>
     <div class="metric-card"><div class="metric-kicker">All-Time High Game</div><div class="metric-main">${highLeader.emoji} ${highLeader.name} · ${highLeader.allTimeHigh}</div><div class="metric-sub">Career record through Year ${careerYear}</div></div>
     <div class="metric-card"><div class="metric-kicker">Best Regular Season Pinfall</div><div class="metric-main">${bestSeason.emoji} ${bestSeason.name} · ${bestSeason.bestSeasonTotal||0}</div><div class="metric-sub">Highest archived 10-week pinfall</div></div>
   </div>
   <div class="panel-head" style="margin-top:20px;"><h2 style="font-size:17px;">Career Résumés</h2><span class="sub">Tap any player</span></div>
   <div class="career-table-wrap"><table class="odds-table career-table"><thead><tr><th>Bowler</th><th>Tier</th><th class="num">Rings</th><th class="num">MVPs</th><th class="num">Top 3</th><th class="num">Avg Finish</th><th class="num">Best Avg</th><th class="num">Best PO Run</th></tr></thead><tbody>${rows}</tbody></table></div>
   <div class="panel-head" style="margin-top:20px;"><h2 style="font-size:17px;">Rivalry Board</h2><span class="sub">Postseason head-to-head</span></div>
   <div class="career-grid">${rivalries}</div>`;
}

function renderRacePanel(){
 const panel=document.getElementById('racePanel'); if(!panel) return;
 if(currentWeek<7 || seasonLocked){panel.style.display='none';return;} panel.style.display='block';
 const remaining=TOTAL_WEEKS-currentWeek;
 const projected=Object.values(PLAYERS).map(pl=>{
   const recent=pl.weeklyTotals.length?mean(pl.weeklyTotals.slice(-3)):pl.careerAvg*9;
   return {pl,projected:Math.round(pl.seasonTotal+recent*remaining)};
 }).sort((a,b)=>b.projected-a.projected);
 const cutoff=projected[7]?.projected||0;
 const chips=projected.map((o,i)=>{
   const seed=i+1, gap=o.projected-cutoff; let cls='race-safe',label='Projected Safe';
   if(seed===8){cls='race-bubble';label='Play-In Bubble';} if(seed===9){cls='race-danger';label='Projected #9';}
   if(seed>=6 && seed<=7){cls='race-bubble';label='Bubble Watch';}
   return `<div class="race-chip ${cls}"><div class="r-seed">Projected #${seed}</div><div class="r-name">${o.pl.emoji} ${o.pl.name}</div><div class="r-meta">${o.projected} projected pins · ${seed===8?'cut line':`${gap>=0?'+':''}${gap} vs #8`} · ${label}</div></div>`;
 }).join('');
 const gap89=projected[7]&&projected[8]?projected[7].projected-projected[8].projected:0;
 document.getElementById('racePanelSub').textContent=`Week ${currentWeek} projection · ${remaining} week${remaining===1?'':'s'} left`;
 document.getElementById('racePanelContent').innerHTML=`<div class="race-grid">${chips}</div><p class="hint" style="margin-bottom:0;">Play-in safety gap: ${gap89} projected pins between #8 and #9. All nine bowlers reach the postseason, so the meaningful cut line is avoiding the 8/9 play-in.</p>`;
}

function openSeasonArchive(year){
 const summary=careerHistoryLog.find(x=>x.year===year); if(!summary) return;
 const rows=Object.values(PLAYERS).map(pl=>pl.careerSeasons?.[year-1]?{pl,s:pl.careerSeasons[year-1]}:null).filter(Boolean).sort((a,b)=>a.s.finish-b.s.finish).map(({pl,s})=>`<tr><td class="odds-seed">#${s.finish}</td><td class="odds-name">${pl.emoji} ${pl.name}</td><td class="num">${s.seasonAvg.toFixed(1)}</td><td class="num">${s.seasonTotal}</td><td class="num">${s.playoffWins}W</td></tr>`).join('');
 document.getElementById('seasonArchiveTitle').textContent=`Year ${year} · Season Archive`;
 document.getElementById('seasonArchiveContent').innerHTML=`
   <div class="career-grid"><div class="metric-card"><div class="metric-kicker">Champion</div><div class="metric-main">${summary.champion?.emoji||''} ${summary.champion?.name||'—'}</div></div><div class="metric-card"><div class="metric-kicker">Regular Season MVP</div><div class="metric-main">${summary.mvp?.emoji||''} ${summary.mvp?.name||'—'}</div><div class="metric-sub">${summary.mvp?.total||0} pins</div></div><div class="metric-card"><div class="metric-kicker">Playoff MVP</div><div class="metric-main">${summary.playoffMVP?summary.playoffMVP.emoji+' '+summary.playoffMVP.name:'—'}</div><div class="metric-sub">${summary.playoffMVP?summary.playoffMVP.wins+' playoff wins':''}</div></div><div class="metric-card"><div class="metric-kicker">High Game</div><div class="metric-main">${summary.highRound?summary.highRound.emoji+' '+summary.highRound.name+' · '+summary.highRound.score:'—'}</div></div></div>
   <div class="archive-standings"><div class="panel-head"><h2 style="font-size:17px;">Final Regular Season Standings</h2><span class="sub">Average · Pinfall · Playoff wins</span></div><div class="career-table-wrap"><table class="odds-table"><thead><tr><th>#</th><th>Bowler</th><th class="num">Avg</th><th class="num">Pins</th><th class="num">PO</th></tr></thead><tbody>${rows}</tbody></table></div></div>`;
 document.getElementById('seasonArchiveModal').classList.remove('hidden');
}

window.__openSeasonArchive=openSeasonArchive;
window.__showPlayerCard=showPlayerCard;

function serializePlayoffs(){
 if(!playoffs) return null;
 return {seedIds:(playoffs.seeds||[]).map(p=>p.id), championId:playoffs.champion?.id||null, recorded:!!playoffs.recorded,recordsWL:playoffs.recordsWL||{},gfWins:playoffs.gfWins||{},played:Object.fromEntries(Object.entries(playoffs.M||{}).map(([k,m])=>[k,m.played?{played:true,skipped:!!m.skipped,result:m.result?{pA:m.result.pA?.id,pB:m.result.pB?.id,gamesA:m.result.gamesA,gamesB:m.result.gamesB,totalA:m.result.totalA,totalB:m.result.totalB,winner:m.result.winner?.id,loser:m.result.loser?.id,winScore:m.result.winScore,loseScore:m.result.loseScore}:null}:null]))};
}

function hydratePlayoffs(data){
 if(!data)return null;
 const seeded=(data.seedIds||[]).map(id=>PLAYERS[id]).filter(Boolean); if(!seeded.length)return null;
 playoffs={seeds:seeded,matches:[],idx:0,champion:null,buildOnly:true,recordsWL:data.recordsWL||{},recorded:!!data.recorded}; buildBracketStructure(); playoffs.gfWins=data.gfWins||{};
 Object.entries(data.played||{}).forEach(([k,x])=>{if(!x||!playoffs.M[k])return;const m=playoffs.M[k];m.played=true;m.skipped=!!x.skipped;if(x.result){const r=x.result,pA=PLAYERS[r.pA],pB=PLAYERS[r.pB],winner=PLAYERS[r.winner],loser=PLAYERS[r.loser];m.result={pA,pB,gamesA:r.gamesA||[],gamesB:r.gamesB||[],totalA:r.totalA,totalB:r.totalB,winner,loser,winScore:r.winScore,loseScore:r.loseScore};}});
 playoffs.champion=data.championId?PLAYERS[data.championId]:null; return playoffs;
}

function snapshotGame(){
 return {version:4,savedAt:new Date().toISOString(),careerModeOn,careerYear,careerMilestones,careerHistoryLog,rivalryBook,seasonNumber,firstInit,currentWeek,weeklyRecaps,seasonLocked,hallOfFame,players:PLAYERS,playoffs:serializePlayoffs()};
}

function autosaveGame(){
 if(!careerModeOn)return;
 try{localStorage.setItem(SAVE_KEY,JSON.stringify(snapshotGame()));const el=document.getElementById('saveStatus');if(el){el.textContent=`Autosaved locally · ${new Date().toLocaleTimeString([], {hour:'numeric',minute:'2-digit'})}`;el.classList.add('good');}}catch(e){const el=document.getElementById('saveStatus');if(el)el.textContent='Autosave unavailable in this browser';}
}

function normalizeLoadedPlayers(raw){
 const base={}; RAW_PLAYERS.forEach(p=>base[p.id]=freshPlayerState(p));
 Object.keys(base).forEach(id=>{if(raw&&raw[id]) Object.assign(base[id],raw[id]); const pl=base[id];pl.regularSeasonMvps=pl.regularSeasonMvps||0;pl.playoffMvps=pl.playoffMvps||0;pl.careerSeasons=pl.careerSeasons||[];pl.championshipYears=pl.championshipYears||[];pl.playerOfWeekAwards=pl.playerOfWeekAwards||0;pl.bestSeasonAvg=pl.bestSeasonAvg||0;pl.bestSeasonTotal=pl.bestSeasonTotal||0;pl.bestPlayoffWins=pl.bestPlayoffWins||0;pl.formState=pl.formState||'NORMAL';pl.formModifier=pl.formModifier||0;pl.formWeeksLeft=pl.formWeeksLeft||0;pl.tier=computeTier(computePrestigeScore(pl),pl);}); return base;
}

function loadSnapshot(data){
 if(!data||!data.players)throw new Error('Not a BCM Bowling League save');
 careerModeOn=!!data.careerModeOn;careerYear=data.careerYear||1;careerMilestones=data.careerMilestones||[];careerHistoryLog=data.careerHistoryLog||[];rivalryBook=data.rivalryBook||{};seasonNumber=data.seasonNumber||1;firstInit=!!data.firstInit;currentWeek=data.currentWeek||0;weeklyRecaps=data.weeklyRecaps||[];seasonLocked=!!data.seasonLocked;hallOfFame=data.hallOfFame||[];PLAYERS=normalizeLoadedPlayers(data.players);playoffs=hydratePlayoffs(data.playoffs);
 document.getElementById('careerModeToggle').checked=careerModeOn;document.getElementById('btnSim5Years').style.display=careerModeOn?'':'none';document.getElementById('btnSim10Years').style.display=careerModeOn?'':'none';
 renderAllCareerPanels();if(weeklyRecaps.length)renderRecap();if(seasonLocked&&playoffs){if(!playoffs.champion)document.getElementById('playoffIntroPanel').style.display='block';renderBracket();}updateResetButtonLabel();
}

function tryRestoreAutosave(){
 try{const raw=localStorage.getItem(SAVE_KEY);if(!raw)return false;loadSnapshot(JSON.parse(raw));return true;}catch(e){console.warn('Autosave could not be restored',e);return false;}
}

function encodeSave(obj){return btoa(unescape(encodeURIComponent(JSON.stringify(obj))));}
function decodeSave(text){return JSON.parse(decodeURIComponent(escape(atob(text.trim()))));}
function openSaveModal(mode){
 const modal=document.getElementById('saveCodeModal'),txt=document.getElementById('saveCodeText'),apply=document.getElementById('btnApplySaveCode'),copy=document.getElementById('btnCopySaveCode');
 if(mode==='import'){document.getElementById('saveCodeTitle').textContent='Import Save Code';document.getElementById('saveCodeHint').textContent='Paste a BCM Bowling League save code below. This replaces the current in-browser state.';txt.value='';apply.style.display='';copy.style.display='none';}
 else{document.getElementById('saveCodeTitle').textContent='Share Save Code';document.getElementById('saveCodeHint').textContent='Copy this code to another device or send it to a friend. Importing it recreates this career.';txt.value=encodeSave(snapshotGame());apply.style.display='none';copy.style.display='';}
 modal.classList.remove('hidden');
}

function renderAllCareerPanels(){
 renderStandings(currentWeek===0);updateStatus();renderHallOfFame();renderCareerMilestones();renderHistoryChannel();renderCareerHub();renderRacePanel();
 if(!seasonLocked){document.getElementById('btnSimWeek').disabled=false;document.getElementById('btnSimAll').disabled=false;}else{document.getElementById('btnSimWeek').disabled=true;document.getElementById('btnSimAll').disabled=true;}
}

/* =========================================================================
   CHAMPIONSHIP ARCADE — full 10-frame bowling game presentation
   ========================================================================= */
let arcade={active:false,A:null,B:null,userId:null,mode:'watch',key:null,matchWins:{},matchGameScores:{A:[],B:[]},gameNo:1,frame:1,turnId:null,gameStates:{},remaining:10,rollsInFrame:[],shotPower:50,shotAim:50,shotSpin:50,meter:0,meterDir:1,meterTimer:null,busy:false,commentary:[],sound:true,seriesFinished:false};

function bowlingScore(frames){
 const rolls=[];frames.forEach(f=>(f.rolls||[]).forEach(x=>rolls.push(x)));
 let score=0,ri=0;for(let f=0;f<10;f++){if(rolls[ri]===undefined)break;if(f===9){score+=rolls.slice(ri).reduce((a,b)=>a+b,0);break;}if(rolls[ri]===10){if(rolls[ri+1]===undefined||rolls[ri+2]===undefined)break;score+=10+rolls[ri+1]+rolls[ri+2];ri+=1;}else if(rolls[ri+1]!==undefined&&rolls[ri]+rolls[ri+1]===10){if(rolls[ri+2]===undefined)break;score+=10+rolls[ri+2];ri+=2;}else{if(rolls[ri+1]===undefined)break;score+=rolls[ri]+rolls[ri+1];ri+=2;}}
 return score;
}
function stateScore(st){return bowlingScore(st.frames);}
function newBowlingState(){return {frames:Array.from({length:10},()=>({rolls:[]})),done:false};}
function frameMarks(rolls,idx){
 if(!rolls||!rolls.length)return '';
 const mark=(v)=>v===0?'−':String(v);
 if(idx<9){if(rolls[0]===10)return 'X';return `${mark(rolls[0])} ${rolls.length>1?(rolls[0]+rolls[1]===10?'/':mark(rolls[1])):''}`;}
 return rolls.map((v,i)=>{if(v===10)return'X';if(i>0&&rolls[i-1]!==10&&rolls[i-1]+v===10)return'/';return mark(v);}).join(' ');
}
function cumulativeByFrame(st){const out=[];for(let i=0;i<10;i++){const temp={frames:st.frames.map((f,j)=>({rolls:j<=i?f.rolls.slice():[]}))};out.push(bowlingScore(temp.frames));}return out;}
function tvScoreRow(pl,st){const cum=cumulativeByFrame(st);return `<div class="score-row"><div class="score-cell score-name">${pl.emoji} ${pl.name}</div>${st.frames.map((f,i)=>`<div class="score-cell"><span class="frame-num">${i+1}</span><div class="frame-marks">${frameMarks(f.rolls,i)}</div><div class="frame-cume">${cum[i]||''}</div></div>`).join('')}<div class="score-cell score-total">${stateScore(st)}</div></div>`;}
function renderTvScoreboard(){return `<div class="tv-scoreboard">${tvScoreRow(arcade.A,arcade.gameStates[arcade.A.id])}${tvScoreRow(arcade.B,arcade.gameStates[arcade.B.id])}</div>`;}

function pinPositionsHtml(){const pts=[[50,0],[43,24],[57,24],[36,48],[50,48],[64,48],[29,72],[43,72],[57,72],[71,72]];return pts.map((p,i)=>`<div class="arcade-pin" data-pin="${i}" style="left:calc(${p[0]}% - 6px);top:${p[1]*.55}px;"></div>`).join('');}
function arcadeComment(text){arcade.commentary.unshift(text);arcade.commentary=arcade.commentary.slice(0,5);}
function playArcadeTone(freq=440,dur=.09,vol=.025){if(!arcade.sound)return;try{const ctx=playArcadeTone.ctx||(playArcadeTone.ctx=new (window.AudioContext||window.webkitAudioContext)());const o=ctx.createOscillator(),g=ctx.createGain();o.frequency.value=freq;g.gain.value=vol;o.connect(g);g.connect(ctx.destination);o.start();g.gain.exponentialRampToValueAtTime(.0001,ctx.currentTime+dur);o.stop(ctx.currentTime+dur);}catch(e){}}
function commentaryHtml(){return `<div class="commentary-box"><div class="commentary-title">BCM Broadcast Booth</div>${arcade.commentary.map((x,i)=>`<div class="commentary-line ${i===0?'latest':''}">${x}</div>`).join('')}</div>`;}

function launchArcadeFinals(){
 if(!playoffs||playoffs.champion)return;const A=winnerOf('WF'),B=winnerOf('LR4');if(!A||!B)return;
 arcade={...arcade,active:true,A,B,userId:null,mode:'watch',key:null,matchWins:{[A.id]:0,[B.id]:0},matchGameScores:{A:[],B:[]},gameNo:1,frame:1,turnId:A.id,gameStates:{[A.id]:newBowlingState(),[B.id]:newBowlingState()},remaining:10,rollsInFrame:[],busy:false,commentary:[],seriesFinished:false};
 document.getElementById('arcadeModal').classList.remove('hidden');document.getElementById('arcadeTopTitle').textContent='BCM Championship · Grand Final';renderArcadeIntro();
}

function finalistCard(pl){const regGames=pl.seasonGames.slice(0,TOTAL_WEEKS*9);const avg=regGames.length?mean(regGames):pl.careerAvg;return `<div class="finalist-card"><div class="finalist-seed">#${pl.seed} SEED</div><div class="finalist-emoji">${pl.emoji}</div><div class="finalist-name">${pl.name}</div><div class="finalist-stats"><div class="finalist-stat"><b>${avg.toFixed(1)}</b><span>Season Avg</span></div><div class="finalist-stat"><b>${pl.championships||0}</b><span>Rings</span></div><div class="finalist-stat"><b>${totalMVPs(pl)}</b><span>MVPs</span></div><div class="finalist-stat"><b>${playoffs.recordsWL?.[pl.id]||0}W</b><span>Playoffs</span></div></div></div>`;}
function rivalryIntro(A,B){const key=[A.id,B.id].sort().join('|'),r=rivalryBook[key];if(!r)return 'First tracked postseason meeting in this rivalry era.';return `${r.meetings} prior playoff meeting${r.meetings===1?'':'s'} · ${A.name} ${r.wins[A.id]||0}-${r.wins[B.id]||0} ${B.name}.`;}
function renderArcadeIntro(){document.getElementById('arcadeStage').innerHTML=`<div class="broadcast-intro"><div class="broadcast-kicker">BCM Sports Network Presents</div><h2>Championship Bowling</h2><p>${rivalryIntro(arcade.A,arcade.B)}</p></div><div class="finalist-grid">${finalistCard(arcade.A)}<div class="vs-medallion">vs</div>${finalistCard(arcade.B)}</div><div class="arcade-choice"><button class="primary" onclick="window.__arcadeChoose('${arcade.A.id}')">Play as ${arcade.A.name}</button><button class="primary" onclick="window.__arcadeChoose('${arcade.B.id}')">Play as ${arcade.B.name}</button><button class="ghost" onclick="window.__arcadeChoose('watch')">Watch CPU vs CPU</button><button class="ghost" onclick="window.__arcadeQuickSim()">Quick Sim Finals</button></div>`;}
window.__arcadeChoose=function(choice){arcade.userId=choice==='watch'?null:choice;arcade.mode=choice==='watch'?'watch':'play';startArcadeMatch(1);};

function startArcadeMatch(matchNo){
 const key=['GF1','GF2','GF3'][matchNo-1];arcade.key=key;if(!key||!playoffs.M[key]||playoffs.M[key].played){if(playoffs.champion){renderTrophyCeremony();return;}}
 arcade.gameNo=1;arcade.matchGameScores={A:[],B:[]};startArcadeGame();
}
function startArcadeGame(){arcade.gameStates={[arcade.A.id]:newBowlingState(),[arcade.B.id]:newBowlingState()};arcade.turnId=arcade.A.id;arcade.frame=1;arcade.remaining=10;arcade.rollsInFrame=[];arcade.commentary=[];arcadeComment(`Game ${arcade.gameNo}: the lights are up. ${arcade.A.name} opens the frame.`);renderArcadeGame();if(!arcade.userId||arcade.turnId!==arcade.userId)setTimeout(cpuArcadeRoll,750);}

function renderArcadeGame(){
 const pl=PLAYERS[arcade.turnId],human=arcade.userId===pl.id;const winsA=playoffs.gfWins?.[arcade.A.id]||0,winsB=playoffs.gfWins?.[arcade.B.id]||0;
 document.getElementById('arcadeStage').innerHTML=`<div class="walkout"><div class="series-score">Championship Series · ${arcade.A.name} ${winsA}-${winsB} ${arcade.B.name}</div><div class="walkout-main">Match ${['GF1','GF2','GF3'].indexOf(arcade.key)+1} · Game ${arcade.gameNo} · Frame ${arcade.frame}</div></div>${renderTvScoreboard()}<div class="arcade-arena"><div class="lane-scene"><div class="crowd"></div><div class="lane-light"></div><div class="gutter left"></div><div class="gutter right"></div><div class="arcade-lane"></div><div class="foul-line"></div><div class="pocket-marker" id="pocketMarker"></div><div class="pin-deck" id="arcadePinDeck">${pinPositionsHtml()}</div><div class="arcade-ball" id="arcadeBall"></div><div class="lane-hud"><div class="bowler">${pl.emoji} ${pl.name}</div><div class="turnmeta">Frame ${arcade.frame} · ${arcade.remaining} pins standing</div></div></div><div class="arcade-sidepanel">${commentaryHtml()}<div id="arcadeControlArea">${human?humanControlsHtml():`<div class="cpu-thinking">${pl.name} is lining up the shot…</div>`}</div></div></div>`;
 if(human)beginPowerMeter();positionPocket();
}

function humanControlsHtml(){return `<div class="arcade-controls"><div class="control-title">Shot Controls</div><div class="arcade-control-row"><label><span>Aim</span><span>Left ◀ · ▶ Right</span></label><input id="arcAim" type="range" min="0" max="100" value="${arcade.shotAim}" oninput="window.__arcadeAim(this.value)"></div><div class="arcade-control-row"><label><span>Spin</span><span>Hook ◀ · ▶ Fade</span></label><input id="arcSpin" type="range" min="0" max="100" value="${arcade.shotSpin}" oninput="window.__arcadeSpin(this.value)"></div><div class="arcade-control-row"><label><span>Power / Timing</span><span>Stop near green</span></label><div class="power-meter"><div class="power-sweet"></div><div class="power-needle" id="powerNeedle"></div></div></div><button class="primary roll-btn" id="arcRollBtn" onclick="window.__arcadeHumanRoll()">Bowl</button><div class="hint" style="margin:0;">Aim for the pocket, add a little hook, then stop the moving meter in the green zone. Player skill still matters.</div></div>`;}
window.__arcadeAim=v=>{arcade.shotAim=+v;positionPocket();};window.__arcadeSpin=v=>{arcade.shotSpin=+v;};
function positionPocket(){const p=document.getElementById('pocketMarker');if(p)p.style.left=`calc(${22+arcade.shotAim*.56}% - 5px)`;}
function beginPowerMeter(){clearInterval(arcade.meterTimer);arcade.meter=8;arcade.meterDir=1;arcade.meterTimer=setInterval(()=>{arcade.meter+=arcade.meterDir*2.8;if(arcade.meter>=100){arcade.meter=100;arcade.meterDir=-1;}if(arcade.meter<=0){arcade.meter=0;arcade.meterDir=1;}const n=document.getElementById('powerNeedle');if(n)n.style.left=`${arcade.meter}%`;},28);}
window.__arcadeHumanRoll=function(){if(arcade.busy)return;clearInterval(arcade.meterTimer);const timing=arcade.meter;performArcadeRoll(PLAYERS[arcade.turnId],{aim:arcade.shotAim,spin:arcade.shotSpin,timing,human:true});};
function cpuArcadeRoll(){if(!arcade.active||arcade.busy||!arcade.turnId)return;const pl=PLAYERS[arcade.turnId];const skill=clamp(calcBlendedAvg(pl),70,235);const aim=clamp(67+(Math.random()-.5)*(48-skill/6),25,92),spin=clamp(44+(Math.random()-.5)*32,18,82),timing=clamp(78+(Math.random()-.5)*(55-skill/6),35,98);performArcadeRoll(pl,{aim,spin,timing,human:false});}

function arcadePinsDown(pl,shot){
 const skill=clamp((calcBlendedAvg(pl)-80)/150,0,1);const targetAim=67,targetSpin=43;const aimErr=Math.abs(shot.aim-targetAim),spinErr=Math.abs(shot.spin-targetSpin),timingErr=Math.abs(shot.timing-80);let quality=1-(aimErr/65+spinErr/90+timingErr/80);quality=clamp(quality,0,1);const base=2.6+skill*4.0+quality*3.2+gaussian()*.9;let pins=Math.round(base);if(arcade.remaining===10&&quality>.72&&Math.random()<(.11+skill*.20+quality*.17))pins=10;return clamp(pins,0,arcade.remaining);
}
function animateArcadeShot(shot,pins,callback){
 const ball=document.getElementById('arcadeBall'),deck=[...document.querySelectorAll('.arcade-pin')];if(ball){ball.style.left=`calc(${18+shot.aim*.64}% - 15px)`;void ball.offsetWidth;ball.classList.add('rolling');}playArcadeTone(180,.16,.03);setTimeout(()=>{deck.slice().sort(()=>Math.random()-.5).slice(0,pins).forEach(p=>p.classList.add('down'));playArcadeTone(pins>=9?720:420,.12,.035);},500);setTimeout(callback,900);
}

function performArcadeRoll(pl,shot){
 arcade.busy=true;const pins=arcadePinsDown(pl,shot);animateArcadeShot(shot,pins,()=>{applyArcadeRoll(pl,pins);arcade.busy=false;});
}

function applyArcadeRoll(pl,pins){
 const st=arcade.gameStates[pl.id],fi=arcade.frame-1,frame=st.frames[fi];frame.rolls.push(pins);arcade.rollsInFrame.push(pins);arcade.remaining-=pins;
 const first=arcade.rollsInFrame[0];let frameDone=false;
 if(fi<9){if(first===10||arcade.rollsInFrame.length>=2)frameDone=true;}else{
   if(arcade.rollsInFrame.length>=3)frameDone=true;
   else if(arcade.rollsInFrame.length===2 && first!==10 && first+arcade.rollsInFrame[1]<10)frameDone=true;
 }
 const isStrike=pins===10&&arcade.rollsInFrame.length===1,isSpare=!isStrike&&arcade.remaining===0;
 if(isStrike){arcadeComment(`💥 STRIKE! ${pl.name} buries the pocket.`);playArcadeTone(880,.22,.045);}else if(isSpare)arcadeComment(`✅ ${pl.name} cleans it up for the spare.`);else if(pins>=9)arcadeComment(`${pl.name} leaves just one standing. Pressure shot.`);else if(pins<=4)arcadeComment(`A rough delivery from ${pl.name}. Only ${pins} go down.`);else arcadeComment(`${pl.name} takes ${pins} pins.`);
 if(fi===9&&!frameDone&&arcade.remaining===0){arcade.remaining=10;arcade.rollsInFrame=[];} // bonus ball reset
 if(frameDone){advanceArcadeTurn();}else{arcade.remaining=Math.max(0,arcade.remaining);renderArcadeGame();if(!arcade.userId||arcade.turnId!==arcade.userId)setTimeout(cpuArcadeRoll,650);}
}

function advanceArcadeTurn(){
 const cur=PLAYERS[arcade.turnId];
 if(cur.id===arcade.A.id){arcade.turnId=arcade.B.id;arcade.remaining=10;arcade.rollsInFrame=[];renderArcadeGame();if(!arcade.userId||arcade.turnId!==arcade.userId)setTimeout(cpuArcadeRoll,650);}
 else{
   if(arcade.frame>=10){finishArcadeGame();return;}
   arcade.frame++;arcade.turnId=arcade.A.id;arcade.remaining=10;arcade.rollsInFrame=[];renderArcadeGame();if(!arcade.userId||arcade.turnId!==arcade.userId)setTimeout(cpuArcadeRoll,650);
 }
}

function finishArcadeGame(){
 const scoreA=stateScore(arcade.gameStates[arcade.A.id]),scoreB=stateScore(arcade.gameStates[arcade.B.id]);arcade.matchGameScores.A.push(scoreA);arcade.matchGameScores.B.push(scoreB);arcade.A.seasonGames.push(scoreA);arcade.B.seasonGames.push(scoreB);
 const who=scoreA>scoreB?arcade.A:scoreB>scoreA?arcade.B:null;arcadeComment(who?`${who.emoji} ${who.name} wins Game ${arcade.gameNo}, ${Math.max(scoreA,scoreB)}-${Math.min(scoreA,scoreB)}.`:`Game ${arcade.gameNo} finishes tied at ${scoreA}.`);
 document.getElementById('arcadeStage').innerHTML=`<div class="game-intermission"><div class="broadcast-kicker">Match ${['GF1','GF2','GF3'].indexOf(arcade.key)+1}</div><h3>${who?who.emoji+' '+who.name+' wins Game '+arcade.gameNo:'Game '+arcade.gameNo+' is tied'}</h3><div class="game-score">${arcade.A.name} ${scoreA} · ${arcade.B.name} ${scoreB}</div><p>${arcade.commentary[0]}</p><button class="primary" onclick="window.__arcadeContinueGame()">${arcade.gameNo<3?'Start Game '+(arcade.gameNo+1):'Finish Match'}</button></div>`;
}
window.__arcadeContinueGame=function(){if(arcade.gameNo<3){arcade.gameNo++;startArcadeGame();}else finishArcadeMatch();};

function finishArcadeMatch(){
 const totalA=arcade.matchGameScores.A.reduce((a,b)=>a+b,0),totalB=arcade.matchGameScores.B.reduce((a,b)=>a+b,0);let winner,loser;if(totalA===totalB){if(Math.random()<.5){winner=arcade.A;loser=arcade.B;}else{winner=arcade.B;loser=arcade.A;}}else{winner=totalA>totalB?arcade.A:arcade.B;loser=winner.id===arcade.A.id?arcade.B:arcade.A;}
 const res={pA:arcade.A,pB:arcade.B,gamesA:arcade.matchGameScores.A.slice(),gamesB:arcade.matchGameScores.B.slice(),totalA,totalB,winner,loser,winScore:Math.max(totalA,totalB),loseScore:Math.min(totalA,totalB)};if(!playoffs.recordsWL)playoffs.recordsWL={};playoffs.recordsWL[winner.id]=(playoffs.recordsWL[winner.id]||0)+1;playoffs.recordsWL[loser.id]=playoffs.recordsWL[loser.id]||0;commitMatch(arcade.key,res);renderBracket();
 if(playoffs.champion){renderTrophyCeremony();return;}
 const next=getNextPlayableMatchKey();document.getElementById('arcadeStage').innerHTML=`<div class="game-intermission"><div class="broadcast-kicker">Championship Match Complete</div><h3>${winner.emoji} ${winner.name} takes the match</h3><div class="game-score">Aggregate ${winner.id===arcade.A.id?totalA:totalB}-${winner.id===arcade.A.id?totalB:totalA}</div><p>Series score: ${arcade.A.name} ${playoffs.gfWins[arcade.A.id]||0}-${playoffs.gfWins[arcade.B.id]||0} ${arcade.B.name}.</p><button class="primary" onclick="window.__arcadeNextMatch()">${next?'Play Next Championship Match':'Continue'}</button></div>`;
}
window.__arcadeNextMatch=function(){const next=getNextPlayableMatchKey();if(!next){if(playoffs.champion)renderTrophyCeremony();return;}startArcadeMatch(['GF1','GF2','GF3'].indexOf(next)+1);};

function quickSimArcadeFinals(){clearInterval(arcade.meterTimer);let guard=0;while(playoffs&&!playoffs.champion&&guard<10){const key=getNextPlayableMatchKey();if(!key)break;if(!['GF1','GF2','GF3'].includes(key)){playNextMatch();guard++;continue;}const A=playoffs.M[key].getA(),B=playoffs.M[key].getB();const res=playMatchTrack(A,B);commitMatch(key,res);guard++;}renderBracket();if(playoffs.champion){arcade.A=winnerOf('WF')||playoffs.champion;arcade.B=winnerOf('LR4')||playoffs.champion;renderTrophyCeremony();}}
window.__arcadeQuickSim=quickSimArcadeFinals;

function renderTrophyCeremony(){
 const c=playoffs.champion;if(!c)return;const summaryWins=playoffs.recordsWL?.[c.id]||0;const bestGame=c.seasonGames.length?Math.max(...c.seasonGames):c.allTimeHigh;document.getElementById('arcadeStage').innerHTML=`<div class="trophy-stage" id="trophyStage"><div class="broadcast-kicker">BCM Bowling League Champion</div><div class="trophy-icon">🏆</div><h2>${c.emoji} ${c.name}</h2><div class="champ-sub">Seed #${c.seed} · Championship secured</div><div class="trophy-stats"><div class="trophy-stat"><b>${summaryWins}W</b><span>Playoff Match Wins</span></div><div class="trophy-stat"><b>${bestGame}</b><span>Best Game This Run</span></div><div class="trophy-stat"><b>${c.championships||0} 💍</b><span>Career Championships</span></div></div><button class="primary" onclick="window.__closeArcade()">Return to League</button></div>`;spawnConfetti();showChampion();}
function spawnConfetti(){const host=document.getElementById('trophyStage');if(!host)return;for(let i=0;i<70;i++){const e=document.createElement('i');e.className='confetti';e.style.left=`${Math.random()*100}%`;e.style.animationDuration=`${2.6+Math.random()*3}s`;e.style.animationDelay=`${Math.random()*1.5}s`;e.style.transform=`rotate(${Math.random()*180}deg)`;if(i%3===0)e.style.background='#7C9CD0';if(i%3===1)e.style.background='#fff';host.appendChild(e);}}
window.__closeArcade=function(){clearInterval(arcade.meterTimer);arcade.active=false;document.getElementById('arcadeModal').classList.add('hidden');renderBracket();showChampion();};

window.__TEST={getState:()=>({careerYear,currentWeek,careerModeOn,history:careerHistoryLog.length,hall:hallOfFame.length,champion:playoffs?.champion?.name||null}),enableCareer:()=>{careerModeOn=true;document.getElementById('careerModeToggle').checked=true;},simYear:()=>advanceCareerYear(true),simYears:n=>simulateCareerYears(n),players:()=>PLAYERS};

 

/* =========================================================================

  EVENTS

  ========================================================================= */

document.getElementById('btnSimWeek').addEventListener('click', ()=>{ simulateWeek(); });

document.getElementById('btnSimAll').addEventListener('click', ()=>{

 while(currentWeek < TOTAL_WEEKS){ simulateWeek(); }

});

document.getElementById('btnReset').addEventListener('click', ()=>{ careerModeOn ? advanceCareerYear(true) : initSeason(); autosaveGame(); });

document.getElementById('careerModeToggle').addEventListener('change', (e)=>{

 careerModeOn = e.target.checked;

 updateResetButtonLabel();

 updateStatus();

 document.getElementById('btnSim5Years').style.display = careerModeOn ? '' : 'none';

 document.getElementById('btnSim10Years').style.display = careerModeOn ? '' : 'none';

 renderCareerHub(); autosaveGame();

});

document.getElementById('btnSim5Years').addEventListener('click', ()=>{ simulateCareerYears(5); });

document.getElementById('btnSim10Years').addEventListener('click', ()=>{ simulateCareerYears(10); });

document.getElementById('followPlayerSelect').addEventListener('change', (e)=>{

 followedPlayerId = e.target.value || null;

});

document.getElementById('btnStartPlayoffs').addEventListener('click', ()=>{

 document.getElementById('playoffIntroPanel').style.display='none';

 renderBracket();

});

document.querySelectorAll('[data-role="nextMatch"]').forEach(btn=>{

 btn.addEventListener('click', ()=>{

   const key = getNextPlayableMatchKey();

   if(!key){ setPlayoffButtonsDisabled(true); return; }

   openMatchForKey(key, false);

 });

});

document.querySelectorAll('[data-role="simAllPlayoffs"]').forEach(btn=>{

 btn.addEventListener('click', ()=>{ simulateAllPlayoffs(); });

});

document.getElementById('btnSimToChamp').addEventListener('click', ()=>{ simToChampionship(); });

document.getElementById('btnWatchFinals').addEventListener('click', ()=>{ launchArcadeFinals(); });

document.getElementById('matchModalCloseBtn').addEventListener('click', ()=>{

 if(matchModal.active && matchModal.res && !playoffs.M[matchModal.key].played){

   // commit the resolved match so closing can't leave an orphaned result

   commitMatch(matchModal.key, matchModal.res);

 }

 closeMatchModal();

});

document.getElementById('playerCardModal').addEventListener('click', (e)=>{

 if(e.target.id==='playerCardModal') e.currentTarget.classList.add('hidden');

});

document.getElementById('matchAnimModal').addEventListener('click', (e)=>{

 if(e.target.id==='matchAnimModal'){

   if(matchModal.active && matchModal.res && !playoffs.M[matchModal.key].played) commitMatch(matchModal.key, matchModal.res);

   closeMatchModal();

 }

});

document.getElementById('btnExportSave').addEventListener('click',()=>openSaveModal('export'));
document.getElementById('btnImportSave').addEventListener('click',()=>openSaveModal('import'));
document.getElementById('btnCopySaveCode').addEventListener('click',async()=>{const txt=document.getElementById('saveCodeText');try{await navigator.clipboard.writeText(txt.value);document.getElementById('btnCopySaveCode').textContent='Copied';setTimeout(()=>document.getElementById('btnCopySaveCode').textContent='Copy Code',1200);}catch(e){txt.select();document.execCommand('copy');}});
document.getElementById('btnApplySaveCode').addEventListener('click',()=>{try{const data=decodeSave(document.getElementById('saveCodeText').value);loadSnapshot(data);autosaveGame();document.getElementById('saveCodeModal').classList.add('hidden');}catch(e){alert('That save code could not be read. Make sure the entire code was pasted.');}});
document.getElementById('btnClearSave').addEventListener('click',()=>{if(confirm('Clear the locally saved BCM Bowling League career?')){try{localStorage.removeItem(SAVE_KEY);}catch(e){}initSeason();autosaveGame();}});
document.getElementById('seasonArchiveModal').addEventListener('click',e=>{if(e.target.id==='seasonArchiveModal')e.currentTarget.classList.add('hidden');});
document.getElementById('saveCodeModal').addEventListener('click',e=>{if(e.target.id==='saveCodeModal')e.currentTarget.classList.add('hidden');});
document.getElementById('btnArcadeSound').addEventListener('click',()=>{arcade.sound=!arcade.sound;document.getElementById('btnArcadeSound').textContent=arcade.sound?'Sound On':'Sound Off';});
document.getElementById('btnArcadeExit').addEventListener('click',()=>{if(!arcade.active)return;clearInterval(arcade.meterTimer);if(confirm('Exit championship presentation? The playoff state already completed will remain saved.')){arcade.active=false;document.getElementById('arcadeModal').classList.add('hidden');renderBracket();}});

 

/* =========================================================================

  INIT

  ========================================================================= */

if(!tryRestoreAutosave()) initSeason();

 

})();
